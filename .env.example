# ===========================================================================
#  «Умный кошелёк» — конфигурация. Скопируйте в .env и заполните значения.
# ===========================================================================

# --- Окружение -------------------------------------------------------------
# local | production
APP_ENV=local
LOG_LEVEL=INFO

# --- MAX Bot API -----------------------------------------------------------
# Токен выдаётся при создании бота: Чат-боты → ⋮ → Настройки
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
# local -> long polling, production -> webhook (голосовые работают только в webhook)
MAX_UPDATES_MODE=polling
MAX_POLL_TIMEOUT_SECONDS=30
MAX_POLL_LIMIT=100
MAX_HTTP_TIMEOUT_SECONDS=40

# Webhook (нужен для production: голосовые сообщения и приём Robokassa)
# В production WEBHOOK_HOST=127.0.0.1 — снаружи доступ только через nginx/HTTPS
WEBHOOK_BASE_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Секретная часть адреса вебхука MAX: /webhook/max/<MAX_WEBHOOK_SECRET>
MAX_WEBHOOK_SECRET=
# Публичный URL, который бот передаёт в POST /subscriptions
MAX_WEBHOOK_URL=

# --- Дополнительный проверяемый секрет для Robokassa -----------------------
# Если задан, запросы к /robokassa/* должны содержать этот заголовок
ROBOKASSA_GATEWAY_TOKEN=

# --- PostgreSQL ------------------------------------------------------------
# Для локальной разработки удобно: docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=postgresql://user:password@localhost:5432/smart_wallet
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Django admin ----------------------------------------------------------
DJANGO_SECRET_KEY=<сгенерируйте-случайную-строку-50-символов>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Владелец бота (user_id в MAX) — видит доп. разделы админки
OWNER_MAX_USER_ID=

# --- AI: LLM (AI Dostup, OpenAI-совместимый API) ---------------------------
AI_DOSTUP_BASE_URL=https://aidostup.site/v1
AI_DOSTUP_API_KEY=
AI_DOSTUP_MODEL=deepseek-v4.1-flash-1017
AI_TIMEOUT_SECONDS=30
# Сколько бесплатных AI-запросов даётся пользователю навсегда
AI_FREE_REQUESTS=10

# --- AI: STT (речь → текст) ------------------------------------------------
STT_PRIMARY_MODEL=gpt-4o-transcribe
# По умолчанию — OpenAI. Для AI Dostup раскомментируйте блок ниже:
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
# AI Dostup принимает /audio/transcriptions с моделью gpt-4o-transcribe
# (проверено scripts/probe_stt.py) — отдельный ключ STT не нужен:
#   STT_API_BASE_URL=https://aidostup.site/v1
#   STT_API_KEY=<тот же ключ AI Dostup>
STT_TIMEOUT_SECONDS=30
STT_MAX_FILE_SIZE_MB=25
STT_LANGUAGE=ru
# auto | gpt-4o-transcribe | whisper-1  (принудительный выбор модели)

# --- Robokassa -------------------------------------------------------------
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_IS_TEST=1
ROBOKASSA_RESULT_URL=
ROBOKASSA_SUCCESS_URL=
ROBOKASSA_FAIL_URL=
# Цена AI-подписки, ₽ в месяц
AI_SUBSCRIPTION_PRICE_RUB=210
AI_SUBSCRIPTION_DAYS=30
